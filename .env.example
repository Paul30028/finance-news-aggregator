# 复制为 .env 后按需填写。所有变量均为可选，仅在 config.yaml 中对应功能
# enabled=true 时才会被使用。切勿把 .env 提交到版本控制。

# Webhook 推送地址（config.yaml -> notify.webhook.enabled: true 时生效）
WEBHOOK_URL=

# Telegram 推送（config.yaml -> notify.telegram.enabled: true 时生效）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：覆盖配置文件路径（一般无需修改）
# APP_CONFIG_PATH=config/config.yaml
# APP_SOURCES_PATH=config/sources.yaml
